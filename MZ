    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new(0.3, 0, 1, 0)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fg = Instance.new("UIGradient", fill)
    fg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.primary),
        ColorSequenceKeypoint.new(1, T.accent),
    })

    local knob = Instance.new("Frame", bar)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0.3, -8, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.ZIndex = 2
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local ks = Instance.new("UIStroke", knob)
    ks.Color = T.accent
    ks.Thickness = 2

    local drag = false
    local function setX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = minV + (maxV - minV) * a
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, -8, 0.5, -8)
        vl.Text = tostring(math.floor(v))
        if cb then cb(v) end
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            setX(i.Position.X)
        end
    end)
    bar.InputEnded:Connect(function() drag = false end)
    U.InputEnded:Connect(function() drag = false end)
    R.RenderStepped:Connect(function()
        if drag then setX(U:GetMouseLocation().X) end
    end)
end

