-- ═══════════ ESP ═══════════
local espHL = {}
local function mkESP(plr)
    if plr == LP then return end
    local function add(char)
        if not char then return end
        local old = char:FindFirstChild("MZ_HL")
        if old then old:Destroy() end
        local hl = Instance.new("Highlight", char)
        hl.Name = "MZ_HL"
        hl.FillColor = T.danger
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0.2
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled = false
        espHL[plr] = hl
    end
    if plr.Character then add(plr.Character) end
    plr.CharacterAdded:Connect(add)
end
for _, p in ipairs(P:GetPlayers()) do mkESP(p) end
P.PlayerAdded:Connect(mkESP)

-- Hitbox
local origSize = {}
local function setHitbox(plr, exp)
    if plr == LP or not plr.Character then return end
    for _, part in ipairs(plr.Character:GetChildren()) do
        if part:IsA("BasePart") then
            if exp then
                if not origSize[part] then origSize[part] = part.Size end
                part.Size = origSize[part] * 2
            else
                if origSize[part] then part.Size = origSize[part] end
            end
 
